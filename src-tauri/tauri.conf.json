{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Expense Tracker",
  "version": "0.11.0",
  "identifier": "com.expensetracker.desktop",
  "build": {
    "frontendDist": "../dist/frontend-angular/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Expense Tracker",
        "width": 1500,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
