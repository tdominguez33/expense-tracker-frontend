{
  "name": "frontend-angular",
  "version": "0.0.0",
  "main": "main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "electron": "wait-on tcp:4200 && electron . --serve",
    "electron:dev": "concurrently -k \"npm run start\" \"npm run electron\"",
    "electron:start": "electron .",
    "electron:build": "ng build --base-href ./ && electron-builder"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "description": "Expense Tracker Application",
  "author": "Expense Tracker",
  "private": true,
  "build": {
    "appId": "com.expensetracker.app",
    "productName": "Expense Tracker",
    "directories": {
      "output": "dist_electron",
      "buildResources": "build"
    },
    "files": [
      "dist/frontend-angular/**/*",
      "public/**/*",
      "main.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    }
  },
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.3",
    "@angular/cli": "^21.1.3",
    "@angular/compiler-cli": "^21.1.0",
    "angular-cli-ghpages": "^3.1.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.5",
    "daisyui": "^4.12.24",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.1.0"
  }
}
